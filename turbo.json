{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_API_URL", "VITE_API_PROXY"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": [
        "APP_ENV",
        "DATABASE_URL",
        "ALEMBIC_DATABASE_URL",
        "REDIS_URL",
        "SECRET_KEY",
        "SEED_DEMO_DATA"
      ]
    },
    "migrate": {
      "cache": false,
      "env": ["APP_ENV", "DATABASE_URL", "ALEMBIC_DATABASE_URL"]
    }
  }
}
