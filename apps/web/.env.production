# Production (vite build, mode=production) — committed template.
#
# API traffic stays same-origin and relative ("/api/v1" in src/lib/api-client.ts):
# serve the built dist/ behind the same reverse proxy or app server that mounts
# the backend at /api/v1. No VITE_ value is needed for a same-origin deploy.
#
# If you must point the browser at a different origin, extend api-client.ts to
# read VITE_API_URL here — do not add it silently.
# VITE_API_URL=https://api.example.com
