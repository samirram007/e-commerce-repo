# Development defaults — committed. Real secrets stay in .env (gitignored).
APP_ENV=dev
LOG_LEVEL=INFO
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Local Postgres (preferred). No Postgres running? Use the SQLite line instead.
DATABASE_URL=DATABASE_URL=postgresql+psycopg://primesysindia:admin@localhost:5432/erp
# DATABASE_URL=sqlite:///./erp_dev.db

REDIS_URL=redis://localhost:6379/0
CACHE_ENABLE=false

# Vite dev server
CORS_ORIGINS=["http://localhost:5173"]

MEDIA_DIR=./media
MAX_UPLOAD_MB=10

# Seed demo data so a fresh dev DB is usable immediately
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!123
