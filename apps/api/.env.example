# Copy to .env and adjust. NEVER commit real credentials.
APP_ENV=dev
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
# Fernet key for payment provider secrets at rest (Settings → Payment gateways
# stores Razorpay/Stripe key secrets + webhook secrets encrypted with it).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In dev a fallback is derived from SECRET_KEY (with a warning); prod refuses to boot without it.
# Losing/changing it makes every saved payment secret unreadable.
PAYMENT_ENCRYPTION_KEY=
# Public base URL of this API — provider webhook URLs are built from it
# ({PUBLIC_API_BASE_URL}/api/v1/payments/webhooks/{provider}/{company_id}).
PUBLIC_API_BASE_URL=http://localhost:8000
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

DATABASE_URL=postgresql+psycopg://erp:erp_dev_change_me@localhost:5432/erp
# For quick local dev/tests without Postgres you may use:
# DATABASE_URL=sqlite:///./erp_dev.db

REDIS_URL=redis://localhost:6379/0
CACHE_ENABLE=false

CORS_ORIGINS=["http://localhost:5173"]

MEDIA_DIR=./media
MAX_UPLOAD_MB=10

# Seed demo data (admin user + demo company) at startup
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!123
