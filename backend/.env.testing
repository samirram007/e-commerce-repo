# Test environment — committed (contains no real secrets).
#
# Reproducing the pytest contract locally:
#   uv run pytest                     # conftest.py sets APP_ENV overrides itself
#
# `APP_ENV=test` selects this file and forces throwaway settings so a stray
# test run can never touch the dev/prod database.
APP_ENV=test
LOG_LEVEL=WARNING
SECRET_KEY=test-secret
ACCESS_TOKEN_TTL_MINUTES=5
REFRESH_TOKEN_TTL_DAYS=1

# Throwaway in-memory database (overridden per-session by conftest anyway)
DATABASE_URL=sqlite:///:memory:

CACHE_ENABLE=false
CORS_ORIGINS=["http://localhost:5173"]
MEDIA_DIR=./media-test

# Never seed in tests — fixtures create their own data
SEED_DEMO_DATA=false

# Tests must not inherit a real/demo gateway from .env: they configure keys
# themselves (see the `razorpay_stub` fixture) and otherwise use the sandbox.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_DEMO=0
