# Copy to .env and adjust. NEVER commit real credentials.
APP_ENV=dev
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

DATABASE_URL=postgresql+psycopg://erp:erp_dev_change_me@localhost:5432/erp
# For quick local dev/tests without Postgres you may use:
# DATABASE_URL=sqlite:///./erp_dev.db

REDIS_URL=redis://localhost:6379/0
CACHE_ENABLE=false

CORS_ORIGINS=["http://localhost:5173"]

MEDIA_DIR=./media
MAX_UPLOAD_MB=10

# Seed demo data (admin user + demo company) at startup
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!123

# Razorpay — online payments for the storefront. Leave blank to use the
# sandbox gateway (mock card/UPI) instead. Webhooks: /api/v1/storefront/shop/payments/razorpay/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TIMEOUT_SECONDS=15

# Abandoned gateway checkouts: unpaid orders older than the timeout are
# cancelled (stock released). Set the sweep interval to 0 to disable the job.
ORDER_PAYMENT_TIMEOUT_MINUTES=30
ORDER_EXPIRY_SWEEP_SECONDS=300
