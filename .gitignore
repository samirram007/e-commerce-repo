# Env / secrets — committed: .env.example, apps/api/.env.development,
# apps/api/.env.testing, apps/web/.env.development, apps/web/.env.production.
# Everything else (local overrides, prod files) stays out of git.
.env
.env.local
.env.*.local
apps/api/.env
apps/api/.env.production
!/.env.example
!/apps/api/.env.example
!/apps/api/.env.development
!/apps/api/.env.testing
!/apps/web/.env.development
!/apps/web/.env.production
